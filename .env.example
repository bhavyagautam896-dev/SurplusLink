NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Neon or local)
# For Neon PostgreSQL, use:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:1234@localhost:5432/surpluslink

# Authentication
JWT_SECRET=super_secret_jwt_key_surpluslink_tpds_2026_secure
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Logistics and matching parameters
AVERAGE_SPEED_KMH=20
ROAD_DETOUR_FACTOR=1.25
DEFAULT_SEARCH_RADIUS_KM=15

# Seed city coordinates (Nagpur, Maharashtra, India)
SEED_CITY=Nagpur
SEED_CITY_LAT=21.1458
SEED_CITY_LNG=79.0882

